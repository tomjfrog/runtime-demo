        B4 --> B5[Push to Artifactory :latest]
        B5 --> B6[kubectl rollout restart]
        B6 --> B7[Pod lands on same node via affinity]
        B7 --> B8[Uses cached OLD image - no pull]
        B8 --> B9[JFrog Runtime: Integrity Violation]
    end

    subgraph Reset["3. Clear Violation"]
        C1[Set imagePullPolicy: Always] --> C2[kubectl rollout restart]
        C2 --> C3[Pod pulls fresh from Artifactory]
        C3 --> C4[Cluster in integrity]
    end

