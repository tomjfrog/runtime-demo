flowchart TB
    subgraph Sync1["1. Sync with Artifactory (optional)"]
        A1[Set imagePullPolicy: Always] --> A2[kubectl rollout restart]
        A2 --> A3[Pod pulls latest from Artifactory]
        A3 --> A4[Cluster in integrity]
    end

    subgraph Setup["2. Setup"]
        B1[Set imagePullPolicy: IfNotPresent] --> B2[kubectl rollout restart]
        B2 --> B3[Pod pulls image, caches on node]
    end

    subgraph Trigger["3. Trigger Violation"]
        C1[Build new image with same tag] --> C2[Push to Artifactory :latest]
        C2 --> C3[kubectl rollout restart]
        C3 --> C4[Pod lands on same node via affinity]
        C4 --> C5[Uses cached OLD image - no pull]
        C5 --> C6[JFrog Runtime: Integrity Violation]
    end

    subgraph Sync2["4. Sync with Artifactory (clear)"]
        D1[Set imagePullPolicy: Always] --> D2[kubectl rollout restart]
        D2 --> D3[Pod pulls fresh from Artifactory]
        D3 --> D4[Cluster in integrity]
    end

    A4 --> B1
    B3 --> C1
    C6 --> D1
    D4 --> B1
